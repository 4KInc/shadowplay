{
  "name": "shadowplay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "test:recognition": "esbuild scripts/recognition/sweep.ts --bundle --platform=node --format=esm --alias:@iwsdk/core=./scripts/recognition/core-stub.mjs --alias:three=./node_modules/three/build/three.module.js --outfile=node_modules/.cache/recognition-sweep.mjs --log-level=warning && node node_modules/.cache/recognition-sweep.mjs",
    "server": "node server/main.ts"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.0-rc.2",
    "@mediapipe/tasks-vision": "^0.10.21",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.181.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.0.0-rc.2",
    "@iwsdk/reference": "1.0.0-rc.2",
    "@iwsdk/vite-plugin-dev": "1.0.0-rc.2",
    "@meta-quest/metavr": "^1.3.2",
    "@types/three": "^0.181.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.5.0",
    "vite": "^7.1.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.181.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
