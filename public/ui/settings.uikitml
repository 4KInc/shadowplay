<!--
  Shadowplay settings, shown beside the open Shadow Journal page.
  Sizes are UIKit units (centimetres). Pressed with hand rays (pinch).
  Selected options are highlighted at runtime by SettingsSystem.
-->
<style>
  .root {
    flex-direction: column;
    width: 38;
    padding-top: 1.5;
    padding-bottom: 1.5;
    padding-left: 2.4;
    padding-right: 2.4;
    gap: 0.75;
    background-color: #17121f;
    border-radius: 2.4;
    border-width: 0.25;
    border-color: #b8863b;
  }

  .title {
    font-size: 2.8;
    font-weight: 700;
    color: #f2c47a;
  }

  .label {
    font-size: 1.5;
    font-weight: 600;
    color: #d9c7a3;
    margin-top: 0.15;
  }

  .row {
    flex-direction: row;
    gap: 0.6;
  }

  .option {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    height: 3.8;
    padding-left: 0.6;
    padding-right: 0.6;
    border-radius: 1.2;
    background-color: #2b2338;
    border-width: 0.15;
    border-color: #4a3d5c;
    color: #f6e3bd;
    font-size: 1.35;
    font-weight: 600;
    cursor: pointer;
  }

  .toggle {
    justify-content: center;
    align-items: center;
    height: 3.8;
    border-radius: 1.2;
    background-color: #2b2338;
    border-width: 0.15;
    border-color: #4a3d5c;
    cursor: pointer;
  }

  .toggle-text {
    color: #f6e3bd;
    font-size: 1.45;
    font-weight: 600;
  }

  .section {
    flex-direction: column;
    gap: 0.75;
  }

  .replay {
    justify-content: center;
    align-items: center;
    height: 4.2;
    margin-top: 0.3;
    border-radius: 1.2;
    background-color: #3a2716;
    border-width: 0.2;
    border-color: #e0a24a;
    color: #f2c47a;
    font-size: 1.5;
    font-weight: 700;
    cursor: pointer;
  }

  .family {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    height: 4.2;
    border-radius: 1.2;
    background-color: #2b2338;
    border-width: 0.15;
    border-color: #4a3d5c;
    cursor: pointer;
  }

  .arrow {
    flex-grow: 0;
    width: 5;
    font-size: 2;
  }

  .story-name {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.3;
    min-height: 6;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 1;
    padding-right: 1;
    border-radius: 1.2;
    background-color: #2b2338;
    border-width: 0.15;
    border-color: #4a3d5c;
  }

  .story-title {
    font-size: 1.55;
    font-weight: 700;
    color: #f2c47a;
    text-align: center;
  }

  .story-blurb {
    font-size: 1.15;
    color: #d9c7a3;
    text-align: center;
  }

  .family-status {
    font-size: 1.35;
    color: #f2c47a;
    text-align: center;
  }

  .status {
    font-size: 1.25;
    color: #bfae8e;
    text-align: center;
  }
</style>
<div class="root">
  <div class="title">Settings</div>

  <div class="label">For your family</div>
  <div class="row">
    <button id="record-button" class="family">
      <span id="record-label" class="toggle-text">Record a story</span>
    </button>
    <button id="send-button" class="family">
      <span id="send-label" class="toggle-text">Send to family</span>
    </button>
    <button id="inbox-button" class="family">
      <span id="inbox-label" class="toggle-text">Goodnights</span>
    </button>
  </div>
  <div class="row">
    <button id="live-button" class="family">
      <span id="live-label" class="toggle-text">Go live</span>
    </button>
    <button id="talk-button" class="family">
      <span id="talk-label" class="toggle-text">Talk: Off</span>
    </button>
    <button id="duet-button" class="family">
      <span id="duet-label" class="toggle-text">Take turns: Off</span>
    </button>
  </div>
  <div id="family-status" class="family-status">Record a bedtime story, or go live with your family.</div>

  <div class="label">Tonight's story</div>
  <div class="row">
    <button id="story-prev" class="option arrow">&lt;</button>
    <div class="story-name">
      <span id="story-title" class="story-title">The Moth Who Borrowed Light</span>
      <span id="story-blurb" class="story-blurb">Help Mo find her glow.</span>
    </div>
    <button id="story-next" class="option arrow">&gt;</button>
  </div>
  <button id="story-start" class="family">
    <span id="story-start-label" class="toggle-text">Tell this story</span>
  </button>

  <div class="label">Shape recognition</div>
  <div class="row">
    <button id="tol-strict" class="option">Strict</button>
    <button id="tol-normal" class="option">Normal</button>
    <button id="tol-forgiving" class="option">Forgiving</button>
    <button id="tol-very-forgiving" class="option">Very forgiving</button>
  </div>

  <div class="label">Show-me hints</div>
  <div class="row">
    <button id="hint-off" class="option">Off</button>
    <button id="hint-delayed" class="option">After 15 s</button>
    <button id="hint-always" class="option">Always</button>
  </div>

  <div class="label">Two-hand shapes</div>
  <button id="one-hand-toggle" class="toggle">
    <span id="one-hand-label" class="toggle-text">One-hand mode: Off</span>
  </button>

  <div id="voice-section" class="section">
    <div class="label">Narration (test only)</div>
    <button id="voice-toggle" class="toggle">
      <span id="voice-label" class="toggle-text">Placeholder voice: Off</span>
    </button>
  </div>

  <div id="chapter-section" class="section">
  <div class="label">Play a chapter</div>
  <div class="row">
    <button id="chap-prologue" class="option">Prologue</button>
    <button id="chap-ch1" class="option">1</button>
    <button id="chap-ch2" class="option">2</button>
    <button id="chap-ch3" class="option">3</button>
    <button id="chap-ch4" class="option">4</button>
    <button id="chap-ch5" class="option">5</button>
  </div>
  </div>

  <div class="label">Stage</div>
  <button id="replace-stage-button" class="toggle">
    <span class="toggle-text">Move stage here</span>
  </button>
  <div class="story-blurb">Pinch, then look where you want the stage.</div>

  <button id="replay-button" class="replay">Replay story from the beginning</button>
  <div id="status-text" class="status">Pinch an option to choose it.</div>
</div>
