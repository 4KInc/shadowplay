      "u": 0.26,
      "v": -0.26
    },
    {
      "id": "wolf-path",
      "type": "narrate",
      "text": "Beyond the river the path runs into the woods. And on the path, a wolf."
    },
    {
      "id": "two-ways",
      "type": "narrate",
      "text": "Mo trembles. There are two ways past: be bigger than a wolf, or be something a wolf cannot catch."
    },
    {
      "id": "wolf-choice",
      "type": "choice",
      "text": "Make a dog to face the wolf, or two hands side by side to become a bird.",
      "options": [
        {
          "shape": "dog",
          "outlineU": -0.3,
          "outlineV": -0.12,
          "goto": "dog-path"
        },
        {
          "shape": "bird",
          "alt": "open",
          "outlineU": -0.12,
          "outlineV": 0.3,
          "goto": "bird-path"
        }
      ]
    },
    {
      "id": "dog-path",
      "type": "narrate",
      "text": "A dog! But the wolf is not afraid of a little dog."
    },
    {
      "id": "dog-grow",
      "type": "grow",
      "text": "Bring your hand close to the lamp. Grow, and grow, until you are huge!",
      "factor": 1.8,
      "minSize": 0.4
    },
    {
      "id": "wolf-flees",
      "type": "actor",
      "state": "fleeing"
    },
    {
      "id": "dog-wins",
      "type": "narrate",
      "text": "The wolf takes one look at your great shadow, and runs."
    },
    {
      "id": "mo-rides-dog",
      "type": "moth",
      "mode": "riding"
    },
    {
      "id": "dog-walk",
      "type": "carry",
      "toU": 0.3,
      "text": "Lead Mo down the path."
    },
    {
      "id": "dog-done",
      "type": "goto",
      "to": "ch3-end"
    },
    {
      "id": "bird-path",
      "type": "narrate",
      "text": "A bird! Mo tucks herself under your wing."
    },
    {
      "id": "mo-rides-bird",
      "type": "moth",
      "mode": "riding"
    },
    {
      "id": "fly-over",
      "type": "carry",
      "toU": 0.34,
      "minV": 0.12,
      "text": "Fly high over the wolf's head."
