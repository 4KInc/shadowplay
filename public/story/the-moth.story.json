    {
      "id": "wolf-dozes",
      "type": "actor",
      "state": "dozing"
    },
    {
      "id": "bird-wins",
      "type": "narrate",
      "text": "High above, the wolf never even looked up. It yawns, and falls asleep."
    },
    {
      "id": "ch3-end",
      "type": "moth",
      "mode": "resting",
      "restU": 0.44,
      "restV": 0.05
    },
    {
      "id": "ch3-bow",
      "type": "release",
      "text": "Your shadow bows, and the woods grow quiet."
    },
    {
      "id": "journal-ch3",
      "type": "journal",
      "creature": "$last",
      "text": "$name added to your Shadow Journal."
    },
    {
