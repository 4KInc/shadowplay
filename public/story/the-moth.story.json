      "type": "chapter",
      "chapter": "Chapter Three",
      "text": "Chapter Three: The Wolf"
    },
    {
      "id": "forest",
      "type": "scenery",
      "set": "forest"
    },
    {
      "id": "mo-path",
      "type": "moth",
