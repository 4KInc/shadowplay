    {
      "id": "dog-done",
      "type": "goto",
      "to": "ch3-end"
    },
    {
      "id": "bird-path",
      "type": "narrate",
      "text": "A bird! Mo tucks herself under your wing."
    },
    {
      "id": "mo-rides-bird",
      "type": "moth",
      "mode": "riding"
    },
    {
      "id": "fly-over",
      "type": "carry",
      "toU": 0.34,
      "minV": 0.12,
      "text": "Fly high over the wolf's head."
