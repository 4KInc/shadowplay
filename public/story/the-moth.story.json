      "id": "wolf-dozes",
      "type": "actor",
      "state": "dozing"
    },
    {
      "id": "bird-wins",
      "type": "narrate",
      "text": "High above, the wolf never even looked up. It yawns, and falls asleep."
    },
    {
      "id": "ch3-end",
      "type": "moth",
      "mode": "resting",
      "restU": 0.44,
      "restV": 0.05
    },
