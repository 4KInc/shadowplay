      "id": "wolf-flees",
      "type": "actor",
      "state": "fleeing"
    },
    {
      "id": "dog-wins",
      "type": "narrate",
      "text": "The wolf takes one look at your great shadow, and runs."
    },
    {
      "id": "mo-rides-dog",
      "type": "moth",
      "mode": "riding"
    },
    {
      "id": "dog-walk",
      "type": "carry",
      "toU": 0.3,
      "text": "Lead Mo down the path."
