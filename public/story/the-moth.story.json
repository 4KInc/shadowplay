      "id": "want-fish",
      "type": "request",
      "shape": "fish",
      "alt": "dog",
      "outlineU": 0,
      "outlineV": -0.18,
      "text": "Make a fish: a flat hand, fingers together, thumb tucked in."
    },
    {
      "id": "fish-yes",
      "type": "narrate",
      "text": "A fish! But is it big enough to carry her?"
    },
    {
      "id": "grow-fish",
      "type": "grow",
      "text": "Move your hand closer to the lamp. Make the fish big enough to carry Mo.",
      "factor": 1.4,
      "minSize": 0.25
    },
    {
      "id": "fish-big",
      "type": "narrate",
      "text": "Big enough. Climb aboard, Mo."
    },
    {
      "id": "mo-boards",
      "type": "moth",
      "mode": "riding"
    },
    {
      "id": "swim",
      "type": "carry",
      "toU": 0.3,
      "text": "Swim across the river."
    },
    {
      "id": "mo-far-bank",
      "type": "moth",
      "mode": "resting",
      "restU": 0.42,
      "restV": 0.02
    },
    {
      "id": "fish-goes",
      "type": "release",
      "text": "The fish flicks its tail and slips back into the dark water."
    },
    {
      "id": "journal-fish",
      "type": "journal",
      "creature": "fish",
      "text": "Fish added to your Shadow Journal."
    },
    {
      "id": "end-ch2",
      "type": "narrate",
      "text": "End of Chapter Two."
    },
    {
      "id": "go-on-2",
      "type": "continue",
      "text": "Raise an open hand into the light to go on, or pinch the lamp switch to rest."
    },
    {
