      "restU": -0.4,
      "restV": 0.05
    },
    {
      "id": "river-dark",
      "type": "narrate",
      "text": "A dark river runs under the moon. Mo cannot swim, and the far bank is a long way off."
    },
    {
      "id": "river-carry",
      "type": "narrate",
      "text": "Something in the water could carry her, if it were big enough."
    },
    {
      "id": "want-fish",
      "type": "request",
      "shape": "fish",
      "alt": "dog",
      "outlineU": 0,
      "outlineV": -0.18,
      "text": "Make a fish: a flat hand, fingers together, thumb tucked in."
    },
    {
      "id": "fish-yes",
      "type": "narrate",
      "text": "A fish! But is it big enough to carry her?"
    },
    {
      "id": "grow-fish",
      "type": "grow",
